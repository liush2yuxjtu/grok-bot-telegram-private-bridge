# Optional path overrides. bin/start does not source this file automatically.
# Never put token contents here. TELEGRAM_TOKEN_FILE points to a 0600 file.
TELEGRAM_TOKEN_FILE=/home/box/.local/share/telegram-grok-bridge/secrets/token
GATEWAY_PATH=/home/box/sand-data/gateway.json
STATE_PATH=/home/box/.local/share/telegram-grok-bridge/state.json
GROK_AGENT_NAME=My Bot
